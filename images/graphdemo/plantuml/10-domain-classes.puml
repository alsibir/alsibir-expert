@startuml
!include theme.puml
hide circle
class "Заявка" as Request {
 номер : Строка
 тема : Строка
 описание : Строка
 версия : Целое
 --
 зарегистрировать()
 разрешёнПереход(роль, статус)
 изменитьСтатус(статус, версия)
}
class "Учётная запись" as User {
 идентификатор : UUID
 роль : Роль
 блокирована : Логическое
}
class "Статус заявки" as Status {
 код : Строка
 терминальный : Логическое
}
class "Комментарий" as Comment {
 текст : Строка
 датаСоздания : Момент
}
class "Вложение" as File {
 имя : Строка
 размер : Целое
 хеш : Строка
 результатПроверки : Строка
}
User "1" -- "0..*" Request : автор
User "0..1" -- "0..*" Request : ответственный
Request "0..*" --> "1" Status
Request "1" *-- "0..*" Comment
Request "1" *-- "0..*" File
note bottom of Request
Тема: 5–120 символов.
Описание: 10–4000 символов.
Изменение: только при совпадении версии.
Ответственный: роль OPERATOR.
end note
@enduml
