+<script>
+ function initMenu() {
+  const menu = document.querySelector<HTMLDetailsElement>('.aps-menu');
+  if (!menu || menu.dataset.ready) return;
+  menu.dataset.ready = 'true';
+  const media = matchMedia('(max-width: 1100px)');
+  const sync = () => { menu.open = !media.matches; };
+  sync(); media.addEventListener('change', sync);
+  menu.addEventListener('keydown', e => { if (e.key === 'Escape' && media.matches) { menu.open = false; menu.querySelector('summary')?.focus(); } });
+ }
+ initMenu(); document.addEventListener('astro:page-load', initMenu);
+</script>
