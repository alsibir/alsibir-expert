+++ b/scripts/audit-anchors.py
@@ -0,0 +1,27 @@
+from pathlib import Path
+from html.parser import HTMLParser
+from urllib.parse import urlsplit,unquote
+import json
+r=Path(__file__).resolve().parents[1];root=r/'dist';pages={};links=[]
+class P(HTMLParser):
+ def handle_starttag(self,t,a):
+  d=dict(a)
+  if 'id' in d:self.ids.add(d['id'])
+  if t=='a' and 'href' in d:links.append((self.file,d['href']))
+for f in root.rglob('*.html'):
+ p=P();p.file=f;p.ids=set();p.feed(f.read_text());pages[f.resolve()]=p.ids
+bad=[]
+for f,u in links:
+ v=urlsplit(u)
+ if v.scheme or v.netloc or not v.fragment:continue
+ path=unquote(v.path);frag=unquote(v.fragment)
+ if not path:q=f
+ elif path.startswith('/alsibir-expert/'):q=root/path[len('/alsibir-expert/'):]
+ elif path.startswith('/'):continue
+ else:q=f.parent/path
+ if q.is_dir():q=q/'index.html'
+ ids=pages.get(q.resolve())
+ if ids is not None and frag not in ids:bad.append([str(f.relative_to(root)),u])
+(r/'audit/anchor-check.json').write_text(json.dumps(bad,ensure_ascii=False,indent=2));print(len(bad));print(json.dumps(bad[:20],ensure_ascii=False,indent=2))
+
+raise SystemExit(bool(bad))
diff --git a/scripts/audit.py b/scripts/audit.py
new file mode 100644
index 0000000..8cee725
--- /dev/null
+++ b/scripts/audit.py
@@ -0,0 +1,31 @@
+"""Проверка локальных URL и изображений готовой сборки. Без сетевых запросов."""
+from pathlib import Path
+from html.parser import HTMLParser
+from urllib.parse import urlsplit,unquote
+import json,re,sys
+r=Path(__file__).resolve().parents[1];root=r/'dist';errors=[];count=0
+class Parser(HTMLParser):
+ def handle_starttag(self,tag,attrs):
+  global count
+  d=dict(attrs)
+  for attr in ('href','src','poster'):
+   u=d.get(attr,'');v=urlsplit(u)
+   if not u or v.scheme or v.netloc or u.startswith('#'):continue
+   p=unquote(v.path)
+   if not p:continue
+   count+=1
+   if p.startswith('/alsibir-expert/'):target=root/p[len('/alsibir-expert/'):]
+   elif p=='/alsibir-expert':target=root
+   elif p.startswith('/'):errors.append([str(self.file.relative_to(root)),u,'outside base']);continue
+   else:target=self.file.parent/p
+   if not target.exists() and not (target/'index.html').exists():errors.append([str(self.file.relative_to(root)),u,'missing'])
+  if tag=='img' and 'alt' not in d:errors.append([str(self.file.relative_to(root)),d.get('src'),'missing alt'])
+for f in root.rglob('*.html'):
+ p=Parser();p.file=f;p.feed(f.read_text())
+for f in (root/'images').rglob('*'):
+ if f.is_file() and f.suffix.lower() in ('.webp','.png','.jpg','.jpeg'):
+  b=f.read_bytes()
+  valid=(b.startswith(b'RIFF') and b[8:12]==b'WEBP') if f.suffix.lower()=='.webp' else (b.startswith(b'\x89PNG\r\n\x1a\n') if f.suffix.lower()=='.png' else b.startswith(b'\xff\xd8'))
+  if not valid:errors.append([str(f.relative_to(root)),'','invalid image signature'])
+report={'checked_urls':count,'errors':errors}
+(r/'audit/link-check.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print(json.dumps(report,ensure_ascii=False,indent=2));sys.exit(bool(errors))
diff --git a/scripts/cleanup.py b/scripts/cleanup.py
new file mode 100644
index 0000000..1413796
--- /dev/null
+++ b/scripts/cleanup.py
@@ -0,0 +1,22 @@
+"""Без параметров — просмотр; --apply — перемещение; --restore — возврат."""
+from pathlib import Path
+import json, hashlib, argparse
+p=argparse.ArgumentParser(); g=p.add_mutually_exclusive_group();g.add_argument('--apply',action='store_true');g.add_argument('--restore',action='store_true');a=p.parse_args()
+r=Path(__file__).resolve().parents[1]
+items=json.loads((r/'audit/cleanup-manifest.json').read_text())
+plan=[]
+for x in items:
+ rel=Path(x['path'])
+ if rel.is_absolute() or '..' in rel.parts: raise SystemExit('Unsafe manifest path')
+ src=r/rel; dst=src.parent/'СТОРОННЕЕ'/src.name
+ if a.restore:src,dst=dst,src
+ if not src.exists():continue
+ if src.is_symlink() or not src.resolve().is_relative_to(r):raise SystemExit('Unsafe source')
+ if hashlib.sha256(src.read_bytes()).hexdigest()!=x['sha256']:raise SystemExit('Changed: '+str(src))
+ if dst.parent.exists() and not dst.parent.resolve().is_relative_to(r):raise SystemExit('Unsafe destination')
+ if dst.exists():raise SystemExit('Destination exists: '+str(dst))
+ plan.append((src,dst))
+for src,dst in plan:
+ print(src.relative_to(r),'->',dst.relative_to(r))
+ if a.apply or a.restore:
+  dst.parent.mkdir(exist_ok=True);src.rename(dst)
