---
const { name, size=24 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class="nav-icon" aria-hidden="true"><img class="theme-light" src={`${base}img/${name}-light.svg`} width={size} height={size} alt=""/><img class="theme-dark" src={`${base}img/${name}-dark.svg`} width={size} height={size} alt=""/></span>