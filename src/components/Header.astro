---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import NavIcon from './NavIcon.astro';
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (path: string) => currentPath === path.replace(/\/+$/, '') || (path.endsWith('/blog/') && currentPath.startsWith(path));
---
<div class:list={["aps-header", {"aps-home-header": Astro.url.pathname.replace(/^\/alsibir-expert/, "") === "/"}]}><DefaultHeader/><details class="aps-menu" open><summary>Меню</summary><nav class="aps-top-nav" aria-label="Основная навигация"><a aria-current={isCurrent('/alsibir-expert/wiki/pages/services/') ? 'page' : undefined} href="/alsibir-expert/wiki/pages/services/"><NavIcon name="requirements"/>Услуги</a><a aria-current={isCurrent('/alsibir-expert/wiki/pages/portfolio/') ? 'page' : undefined} href="/alsibir-expert/wiki/pages/portfolio/"><NavIcon name="documentation"/>Работы</a><a aria-current={isCurrent('/alsibir-expert/blog/') ? 'page' : undefined} href="/alsibir-expert/blog/"><NavIcon name="file"/>Блог</a><a aria-current={isCurrent('/alsibir-expert/wiki/') ? 'page' : undefined} href="/alsibir-expert/wiki/"><NavIcon name="documentation"/>Знания</a><a aria-current={isCurrent('/alsibir-expert/wiki/pages/contact/') ? 'page' : undefined} href="/alsibir-expert/wiki/pages/contact/"><NavIcon name="email"/>Контакты</a><a aria-current={isCurrent('/alsibir-expert/wiki/pages/sitemap/') ? 'page' : undefined} href="/alsibir-expert/wiki/pages/sitemap/" aria-label="Карта сайта"><NavIcon name="menu"/><span class="map-label">Карта сайта</span></a><div class="aps-mobile-theme"><ThemeSelect/></div></nav></details></div>
<script>
 function initMenu() {
  const menu = document.querySelector<HTMLDetailsElement>('.aps-menu');
  if (!menu || menu.dataset.ready) return;
  menu.dataset.ready = 'true';
  const media = matchMedia('(max-width: 1100px)');
  const sync = () => { menu.open = !media.matches; };
  sync(); media.addEventListener('change', sync);
  menu.addEventListener('keydown', e => { if (e.key === 'Escape' && media.matches) { menu.open = false; menu.querySelector('summary')?.focus(); } });
 }
 initMenu(); document.addEventListener('astro:page-load', initMenu);
</script>
