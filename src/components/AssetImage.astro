---
interface Props { name: string; alt: string; class?: string; eager?: boolean; }
const {name,alt,class:cls='',eager=false}=Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class:list={['theme-image',cls]}><img class="theme-light" src={`${base}images/light/${name}.webp`} alt={alt} loading={eager?'eager':'lazy'} decoding="async" width={name==='portrait'?1086:1536} height={name==='portrait'?1448:1024}/><img class="theme-dark" src={`${base}images/dark/${name}.webp`} alt={alt} loading={eager?'eager':'lazy'} decoding="async" width={name==='portrait'?1086:1536} height={name==='portrait'?1448:1024}/></span>