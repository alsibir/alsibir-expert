---
interface Props { name: string; alt: string; class?: string; eager?: boolean; lightPortrait?: boolean; }
const {name,alt,class:cls='',eager=false,lightPortrait=false}=Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class:list={['theme-image',cls]}>
  {name === 'portrait' ? (
    <>
    {lightPortrait && <img class="theme-light" src={`${base}images/portrait-light.webp`} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" width="1060" height="1484"/>}
    <img class:list={[{'theme-dark': lightPortrait}]} src={`${base}images/1.jpg`} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" width="1097" height="1536"/>
    </>
  ) : (
    <><img class="theme-light" src={`${base}images/light/${name}.webp`} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1536" height="1024"/><img class="theme-dark" src={`${base}images/dark/${name}.webp`} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1536" height="1024"/></>
  )}
</span>
