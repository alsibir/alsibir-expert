---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import AssetImage from './AssetImage.astro';
const isHome = Astro.url.pathname.replace(/^\/alsibir-expert/, '') === '/';
---
{isHome ? (
  <section class="aps-home-hero" aria-labelledby="_top">
    <div>
      <p class="aps-home-eyebrow">Аналитик · Технический писатель</p>
      <h1 id="_top"><span>Александр</span>{" "}<span>Сибиряков</span></h1>
      <p class="aps-home-intro">Анализ требований, моделирование процессов и разработка технической документации по ГОСТ 19, 34 и 21.</p>
      <p class="aps-home-motto">От описания системы до испытаний и руководства пользователя.</p>
      <div class="aps-home-actions">
        <a class="aps-button" href="#real-work">Примеры работ</a>
        <a class="aps-button secondary" href="/alsibir-expert/wiki/pages/resume/">Запросить резюме</a>
        <a class="aps-home-contact" href="/alsibir-expert/wiki/pages/contact/">Обсудить задачу →</a>
      </div>
    </div>
    <AssetImage name="portrait" alt="Александр Сибиряков — аналитик и технический писатель" class="aps-home-portrait" eager/>
  </section>
) : <DefaultHero/>}

