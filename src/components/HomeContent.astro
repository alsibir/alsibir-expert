---
import ClientsPartners from './ClientsPartners.astro';
const projects = [
  { id: 'assistant', title: 'Цифровой аватар «Жириновский»', type: 'Руководство оператора · 30 страниц', task: 'Установка, настройка и работа с цифровым аватаром.', detail: 'Пример описания эксплуатации системы и действий оператора.', image: 'assistant-project-card.png', pdf: 'assistant.pdf' },
  { id: 'snezhinka', title: 'Снежинка', type: 'Техническое задание · 21 страница', task: 'Требования к виртуальному ассистенту мультимедийного стенда.', detail: 'Пример описания функциональности и взаимодействия с пользователем.', image: 'snezhinka-project-card.png', pdf: 'snezhinka.pdf' },
  { id: 'api', title: 'OK Service API', type: 'Описание API · 30 страниц', task: 'Подключение и взаимодействие с программным интерфейсом.', detail: 'Пример документации для разработчиков и интеграторов.', image: 'api-project-card.png', pdf: 'api.pdf' },
];
---
<div class="aps-home-content">
  <div class="aps-home-proof" aria-label="Основные направления опыта">
    <div><strong>ИТ и НИОКР</strong><span>Программные системы и исследовательские проекты</span></div>
    <div><strong>ГОСТ 19 / 34 / 21</strong><span>Требования, документация и испытания</span></div>
    <div><strong>API и ИИ</strong><span>Интерфейсы, нейросети и виртуальные ассистенты</span></div>
  </div>

  <ClientsPartners />


  <section class="aps-showcase" id="projects" aria-labelledby="aps-projects-title">
    <div class="aps-home-section-heading"><div><p class="aps-home-eyebrow">Технологические разработки · Наносемантика</p><h2 id="aps-projects-title">Проекты</h2></div></div>
    <p class="aps-home-section-lead">Проекты в области искусственного интеллекта, робототехники и речевых технологий, в документировании которых участвовал Александр Сибиряков как аналитик и технический писатель.</p>
    <div class="aps-showcase-grid">
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-robot"><span>01 / Робототехника</span><strong>МФТИ</strong></div><div class="aps-showcase-body"><h3>Антропоморфный робот МФТИ</h3><p>Робототехнические разработки и интеллектуальное голосовое взаимодействие. Документирование инженерных решений.</p><a href="/alsibir-expert/wiki/projects/robot-mfti/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-dialog"><span>02 / Разговорный ИИ</span><strong>DialogOS</strong></div><div class="aps-showcase-body"><h3>DialogOS (DOS)</h3><p>Платформа для разработки, обучения и тестирования голосовых и текстовых роботов.</p><a href="/alsibir-expert/wiki/projects/dialogos/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-snow"><span>03 / Цифровые аватары</span><strong>Снежинка</strong></div><div class="aps-showcase-body"><h3>Цифровой аватар «Снежинка»</h3><p>Интерактивный стенд для презентации научных исследований и технологий освоения Арктики.</p><a href="/alsibir-expert/wiki/projects/snezhinka/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-avatar"><span>04 / Интеллектуальные аватары</span><strong>ИИ</strong></div><div class="aps-showcase-body"><h3>Цифровой аватар «Жириновский»</h3><p>Диалоговый цифровой персонаж с применением технологий искусственного интеллекта.</p><a href="/alsibir-expert/wiki/projects/zhirinovsky/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-xray"><span>05 / Компьютерное зрение</span><strong>Рентген-аналитика</strong></div><div class="aps-showcase-body"><h3>Анализ рентген-изображений транспорта</h3><p>Интеллектуальная сегментация и классификация транспортных средств для систем досмотра.</p><a href="/alsibir-expert/wiki/projects/xray-transport/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-uav"><span>06 / Беспилотные системы</span><strong>Автономные платформы</strong></div><div class="aps-showcase-body"><h3>Беспилотные системы</h3><p>Робототехника, управление и документирование инженерных решений.</p><a href="/alsibir-expert/wiki/projects/unmanned/">Подробнее о проекте →</a></div></article>
    </div>
    <p class="aps-showcase-more"><a href="/alsibir-expert/wiki/pages/projects/">Все проекты →</a></p>
    <p class="aps-home-source">Технологии и проекты разработаны компанией «Наносемантика» и её партнёрами. Описано профессиональное участие в подготовке документации; авторство разработок не заявляется.</p>
  </section>

  <section id="real-work" aria-labelledby="real-work-title">
    <div class="aps-home-section-heading"><div><p class="aps-home-eyebrow">Профессиональное портфолио</p><h2 id="real-work-title">Реальные работы</h2></div><a href="/alsibir-expert/wiki/pages/portfolio/">Все примеры →</a></div>
    <p class="aps-home-section-lead">Фрагменты подготовленных документов. Каждый пример можно открыть целиком в PDF.</p>
    <div class="aps-home-projects">
      {projects.map(project => (
        <article class="aps-home-project">
          <a href={`/alsibir-expert/examples/${project.pdf}`} aria-label={`${project.title} — открыть документ PDF`}><img src={`/alsibir-expert/images/evidence/${project.image}`} alt={`${project.title}: титульный лист и фрагмент документа`} width="1600" height="1100" loading="lazy" decoding="async"/></a>
          <div class="aps-home-project-body"><p class="aps-home-document-type">{project.type}</p><h3>{project.title}</h3><p>{project.task}</p><p class="aps-home-project-detail">{project.detail}</p>
            <div class="aps-home-project-links"><a href={`/alsibir-expert/examples/${project.pdf}`}>Открыть PDF →</a><a href={`/alsibir-expert/wiki/pages/portfolio/#${project.id}`}>Подробнее</a></div>
            {project.id === 'assistant' && <p class="aps-home-source">О проекте: <a href="/alsibir-expert/wiki/projects/zhirinovsky/">Описание на сайте АПС</a></p>}
            {project.id === 'snezhinka' && <p class="aps-home-source">О проекте: <a href="/alsibir-expert/wiki/projects/snezhinka/">Описание на сайте АПС</a></p>}
          </div>
        </article>
      ))}
    </div>
    <div class="aps-home-more-work"><p>Другие документы: <a href="/alsibir-expert/examples/orfo.pdf">Техническое задание ОРФО AI</a> · <a href="/alsibir-expert/examples/puzzlelib.pdf">Техническое задание PuzzleLib</a></p><a href="/alsibir-expert/examples/portfolio-samples.zip">Скачать все пять примеров ZIP</a></div>
  </section>

  <section aria-labelledby="experience-title">
    <p class="aps-home-eyebrow">Опыт и профессиональный контекст</p><h2 id="experience-title">Документация для технологических проектов</h2>
    <div class="aps-home-experience">
      <article><h3>«Наносемантика»</h3><p>Работа ведущим техническим писателем-аналитиком. Документация на программные продукты и решения в области искусственного интеллекта.</p></article>
      <article><h3>МГУ и МФТИ</h3><p>Документирование решений для университетских и исследовательских проектов, включая голосовые технологии и робототехнику.</p></article>
      <article><h3>Инженерный подход</h3><p>Техническое образование, анализ исходных данных, согласование требований и проверка связей между документами.</p></article>
    </div>
    <p class="aps-home-source">Сведения о профессиональном опыте предоставлены автором. <a href="/alsibir-expert/wiki/pages/about/">Подробнее о специалисте →</a></p>
  </section>

  <section aria-labelledby="services-title">
    <p class="aps-home-eyebrow">Задачи, с которыми можно обратиться</p><h2 id="services-title">Чем могу быть полезен</h2>
    <div class="aps-home-services">
      <article><span class="aps-home-number" aria-hidden="true">01</span><h3>Техническая документация</h3><p>ТЗ, ПМИ, пояснительные записки, руководства и комплекты документов по ГОСТ.</p></article>
      <article><span class="aps-home-number" aria-hidden="true">02</span><h3>Системный анализ</h3><p>Сбор и согласование требований, сценарии, модели процессов и трассируемость.</p></article>
      <article><span class="aps-home-number" aria-hidden="true">03</span><h3>Документация API</h3><p>Описание интерфейсов и взаимодействий, материалы для разработчиков и интеграторов.</p></article>
      <article><span class="aps-home-number" aria-hidden="true">04</span><h3>Аудит и автоматизация</h3><p>Выявление противоречий, проверка комплектности, шаблоны и средства обработки документов.</p></article>
    </div><p><a href="/alsibir-expert/wiki/pages/services/">Услуги и порядок работы →</a></p>
  </section>

  <section class="aps-home-library" aria-labelledby="library-title">
    <div><p class="aps-home-eyebrow">Отдельный раздел сайта</p><h2 id="library-title">Публикации</h2><p>Практические инструкции по документации, стандартам и инструментам. Авторские комплекты документации показывают подход к решению профессиональных задач.</p><p class="aps-home-source">Демонстрационные материалы специально созданы автором для портфолио на условных данных, без раскрытия конфиденциальных сведений заказчиков.</p></div>
    <nav aria-label="Статьи и демонстрационные материалы"><a href="/alsibir-expert/publications/">Открыть публикации →</a><a href="/alsibir-expert/wiki/portfolio/documentation/technical-documentation/">Посмотреть демонстрационный комплект →</a></nav>
  </section>

  <section class="aps-home-cta" aria-labelledby="contact-title"><div><p class="aps-home-eyebrow">Следующий шаг</p><h2 id="contact-title">Обсудить задачу</h2><p>Для начала достаточно описания системы, назначения документов и имеющихся исходных материалов.</p></div><div class="aps-home-actions"><a class="aps-button" href="/alsibir-expert/wiki/pages/contact/">Контакты</a><a class="aps-home-contact" href="mailto:wordmaster@textpro-1.ru">Написать по электронной почте →</a></div></section>
</div>

<style>
.aps-showcase{margin:clamp(2rem,5vw,4.5rem) 0}.aps-showcase-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin-top:1.5rem}.aps-showcase-card{border:1px solid var(--sl-color-gray-5);border-radius:16px;overflow:hidden;background:var(--sl-color-bg);min-width:0}.aps-showcase-visual{height:170px;display:flex;flex-direction:column;justify-content:space-between;padding:1.25rem;color:#fff;background:#173b5b}.aps-showcase-visual span{font-size:.8rem;letter-spacing:.07em;text-transform:uppercase}.aps-showcase-visual strong{font-size:clamp(1.65rem,3vw,2.7rem);line-height:1.1}.aps-robot{background:linear-gradient(135deg,#0b2638,#236d89)}.aps-dialog{background:linear-gradient(135deg,#152b65,#3979b8)}.aps-snow{background:linear-gradient(135deg,#245e7d,#77a9bb)}.aps-xray{background:linear-gradient(135deg,#0c2639,#137f91)}.aps-uav{background:linear-gradient(135deg,#324a75,#d39c80)}.aps-avatar{background:linear-gradient(135deg,#25334c,#685c88)}.aps-showcase-body{padding:1.2rem}.aps-showcase-body h3{margin:0 0 .6rem;font-size:1.12rem}.aps-showcase-body p{margin:0 0 .65rem;line-height:1.55}.aps-showcase-more{text-align:right;margin-top:1.25rem;font-weight:700}@media(max-width:640px){.aps-showcase-grid{grid-template-columns:1fr}.aps-showcase-visual{height:135px}}
.aps-robot{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/alsibir-expert/images/projects/robot-mfti.webp');background-position:center;background-size:cover}.aps-dialog{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/alsibir-expert/images/projects/dialogos.webp');background-position:center;background-size:cover}.aps-snow{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/alsibir-expert/images/projects/snezhinka.webp');background-position:center;background-size:cover}.aps-avatar{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/alsibir-expert/images/projects/zhirinovsky.webp');background-position:center;background-size:cover}.aps-xray{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/alsibir-expert/images/projects/xray-transport.webp');background-position:center;background-size:cover}.aps-uav{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/alsibir-expert/images/projects/unmanned.webp');background-position:center;background-size:cover}</style>
