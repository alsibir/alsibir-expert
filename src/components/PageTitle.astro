---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import AssetImage from './AssetImage.astro';
const isAbout = Astro.url.pathname.replace(/\/+$/, '').endsWith('/wiki/pages/about');
---
<DefaultPageTitle/>
{isAbout && <AssetImage name="portrait" alt="Александр Сибиряков — аналитик и технический писатель" class="aps-author-portrait"/>}
